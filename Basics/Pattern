public class pattern
{
public static void main(String[] args)
{
int i,j,spaces,k;
for(i=1;i<=4;i++)
{
    for(j=1;j<=i;j++)
    System.out.print("%d",j);
    for(spaces=2*i-2;spaces<6;spaces++)
    system.out.print(" ");
    for(k=i;k>=1;k--)
    System.out.print("%d",k);
   System.out.println()
}
}
}
